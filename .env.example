# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.

# Провайдер LLM: none | anthropic | openai_compat
# none — только шаблоны, стоимость $0, интернет не нужен.
LLM_PROVIDER=none
# Таймаут вызова, с. При превышении остаётся шаблонный черновик (держит p95 < 5 с).
LLM_TIMEOUT=3
# Сколько вызовов в минуту разрешает тариф провайдера (бесплатный Gemini — 15, ставьте чуть меньше).
# HTTP-сервис при выбранной квоте сразу ставит шаблон; make predict ждёт свободный слот.
# 0 — без ограничения (платные тарифы).
LLM_RPM=0

# --- OpenAI: достаточно одного ключа, провайдер и адрес выставятся сами ---
# OPENAI_API_KEY=ваш_ключ
# OPENAI_MODEL=gpt-4o-mini

# --- Claude, официальный SDK ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Модель выбирается здесь. Для лимита кейса $0.002 за тикет:
#   claude-haiku-5-5  $0.10 / $0.50 за 1М токенов -> ~$0.0003 за вызов (укладывается)
#   claude-opus-5-5   $4 / $20 за 1М токенов      -> ~$0.012 за вызов (не укладывается)
# LLM_MODEL=claude-haiku-5-5
# LLM_PRICE_IN=0.10
# LLM_PRICE_OUT=0.50

# --- DeepSeek (OpenAI-совместимый API) ---
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
# LLM_PRICE_IN=   цены за 1М токенов — из прайса провайдера
# LLM_PRICE_OUT=

# --- Gemini (OpenAI-совместимый API) ---
# Ключ из Google AI Studio: AIza... или нового формата AQ....
# gemini-3.5-flash-lite отвечает примерно за 1 с; модели gemini-2.5 новым ключам уже недоступны,
# а gemini-3.8-flash на бесплатном тарифе не укладывалась в таймаут (проверено 2026-10-30).
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_RPM=14

# --- Локально через Ollama: $0, данные не покидают сервер ---
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# LLM_PRICE_IN=0
# LLM_PRICE_OUT=0
